#!/usr/bin/env bash

selection=$(mpc lsplaylists |
    fzf --reverse --no-scrollbar --padding 1,3 --prompt 'Playlist: ')

[[ -z "$selection" ]] && exit 0

before=$(mpc playlist | wc -l)
mpc load "$selection"
after=$(mpc playlist | wc -l)

if ((after > before)); then
    first=$((before + 1))
    if fzf --reverse --prompt 'Play from first playlist song? (y/n): ' \
        <<<$'yes\nno' | grep -q '^yes$'; then
        mpc play "$first"
    fi
fi
